#!/bin/bash
#
# Usage: new-pr [BASE_BRANCH] [BRANCH_NAME]
#
# Creates a new git branch, pushes it to remote, creates a draft PR, and sets up a worktree.
#
# Arguments:
#   BASE_BRANCH  - The branch to branch off from (interactive selection if not provided)
#   BRANCH_NAME  - Name for the new branch (interactive prompt if not provided)
#
# What it does:
#   1. Creates a new branch from BASE_BRANCH
#   2. Makes an empty initial commit
#   3. Pushes the branch to remote
#   4. Creates a draft PR targeting BASE_BRANCH
#   5. Creates a worktree at ../<PR_NUMBER>_<BRANCH_NAME>
#
# Examples:
#   new-pr main my-feature       # Create 'my-feature' branch from 'main'
#   new-pr develop               # Branch from 'develop', prompt for name
#   new-pr                       # Interactive selection for both

set -e

BASE_BRANCH="$1"
BRANCH_NAME="$2"

if [ -z "$BASE_BRANCH" ]; then
    if command -v fzf &> /dev/null; then
        BASE_BRANCH=$(git branch -a | sed 's/^[* ] //' | sed 's/remotes\/origin\///' | sort -u | grep -v '^HEAD' | fzf --height 40% --reverse --prompt="Select base branch: " --query="main")
    else
        read -p "Enter base branch [main]: " BASE_BRANCH
        BASE_BRANCH="${BASE_BRANCH:-main}"
    fi
fi

if [ -z "$BASE_BRANCH" ]; then
    echo "Error: Base branch cannot be empty"
    exit 1
fi

if [ -z "$BRANCH_NAME" ]; then
    read -p "Enter new branch name: " BRANCH_NAME
fi

if [ -z "$BRANCH_NAME" ]; then
    echo "Error: Branch name cannot be empty"
    exit 1
fi

echo "Checking out and updating '$BASE_BRANCH'..."
git checkout "$BASE_BRANCH"
git pull origin "$BASE_BRANCH"

echo "Creating branch '$BRANCH_NAME' from '$BASE_BRANCH'..."
git checkout -b "$BRANCH_NAME" "$BASE_BRANCH"

echo "Creating empty commit..."
git commit --allow-empty -m "Initial commit for $BRANCH_NAME"

echo "Pushing branch to remote..."
git push -u origin "$BRANCH_NAME" --force

echo "Switching back to main branch..."
git checkout -

echo "Creating draft PR..."
PR_URL=$(gh pr create --draft --base "$BASE_BRANCH" --head "$BRANCH_NAME" --title "$BRANCH_NAME" --body "")

PR_NUMBER=$(echo "$PR_URL" | grep -oP '/pull/\K\d+')

if [ -z "$PR_NUMBER" ]; then
    echo "Error: Failed to extract PR number from: $PR_URL"
    exit 1
fi

REPO_NAME=$(basename "$(git rev-parse --show-toplevel)")

SANITIZED_BRANCH=$(echo "$BRANCH_NAME" | sed 's/\//-/g')

WORKTREE_DIR="../${PR_NUMBER}_${SANITIZED_BRANCH}"

echo "Creating worktree at $WORKTREE_DIR..."
git worktree add "$WORKTREE_DIR" "$BRANCH_NAME"

echo ""
echo "✓ Done! PR created: $PR_URL"
echo "✓ Worktree created at: $WORKTREE_DIR"
echo ""

echo "Entering worktree..."
cd "$WORKTREE_DIR"

if [ -f "uv.lock" ]; then
    echo "Found uv.lock, running uv sync..."
    uv sync > /dev/null

    echo "Activating virtualenv..."
    for name in venv .venv; do
        [ -d "$name" ] && source "$name/bin/activate"
    done

    if [ -f ".pre-commit-config.yaml" ]; then
        echo "Installing pre-commit hooks..."
        uv run pre-commit install > /dev/null
    fi
fi

echo ""
